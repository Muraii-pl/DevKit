{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run check)",
      "Bash(npm test:*)",
      "Bash(npx stylelint:*)",
      "Bash(git diff:*)",
      "Bash(git status)",
      "Bash(git log:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)", "Read(./**/*.pem)", "Read(./**/*.key)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/format-edited-file.sh" }]
      }
    ]
  }
}
